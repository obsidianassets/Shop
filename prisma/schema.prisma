generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())
  ledger    Ledger[]
}

model Ledger {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amountCents Int
  reason      String
  createdAt   DateTime @default(now())
}

model TopUp {
  id          String   @id @default(cuid())
  userId      String
  txHash      String   @unique
  amountCents Int
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model Product {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  priceCents Int
  stock      StockItem[]
}

model StockItem {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  payload   String
  status    String  @default("available")
  orderId   String?
}